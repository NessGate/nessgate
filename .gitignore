# Local operator tools — kept out of the public repo (read only the public registry.json)
/NessGate-Stats.bat
/dashboard.html

# MCP Registry publishing — Ed25519 private key for domain (HTTP) auth. Never commit.
/mcp-key*.pem
# Downloaded mcp-publisher binary (not source).
/.tools/
/.private/

# Transient benchmark stdout/stderr (results .jsonl are committed; logs are not)
benchmarks/*.log
benchmarks/*.err

# competitive-benchmark transient outputs (results-holdout.jsonl + REPORT committed)
benchmarks/competitive/*.log
benchmarks/competitive/results-smoke.jsonl

# real-world benchmark transient logs (corpus.json + results.jsonl + REPORT committed)
benchmarks/realworld/*.log

# Python bytecode from running the examples
__pycache__/
*.pyc

# connection-plan lab: transient run outputs (the code, README, and PROPOSAL are committed)
lab/connection-plan/*.log
lab/connection-plan/last-run*.json
lab/connection-plan/market-*.json

# nessgate-inspect lab: transient run outputs (scripts and docs are committed)
lab/nessgate-inspect/last-run*.json
lab/nessgate-inspect/*.log

# MCP Registry domain-verification private key (local only; the public half is served at /.well-known/mcp-registry-auth)
.mcp-registry-key.txt

# validation lab: consumer-install artifacts (scripts and REPORT are committed)
lab/validation/node_modules/
lab/validation/package.json
lab/validation/package-lock.json
