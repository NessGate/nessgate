/icon-192.png
  Cache-Control: public, max-age=86400

/icon-512.png
  Cache-Control: public, max-age=86400

/icon-maskable-192.png
  Cache-Control: public, max-age=86400

/icon-maskable-512.png
  Cache-Control: public, max-age=86400

/logo-horizontal.svg
  Cache-Control: public, max-age=86400

/safari-pinned-tab.svg
  Cache-Control: public, max-age=86400

/favicon-48x48.png
  Cache-Control: public, max-age=86400

/mstile-150x150.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=3600

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=86400

/llms.txt
  Cache-Control: public, max-age=3600

